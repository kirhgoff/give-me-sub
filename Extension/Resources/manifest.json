{
  "manifest_version": 2,
  "name": "GiveMeSub",
  "version": "0.1",
  "description": "Live on-device captions for videos.",
  "icons": { "128": "icon.png" },
  "permissions": ["nativeMessaging", "activeTab", "tabs"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "all_frames": true }]
}
